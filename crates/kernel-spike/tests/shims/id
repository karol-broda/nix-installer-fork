#!/bin/sh
# Fake `id -u NAME`: prints the uid from $SPIKE_SHIM_STATE, or exits 1
# (no-such-user) like the real one.
state="${SPIKE_SHIM_STATE:?SPIKE_SHIM_STATE not set}"
[ "$1" = "-u" ] || exit 2
name="$2"
line="$(grep "^$name " "$state" 2>/dev/null | head -n 1)"
if [ -z "$line" ]; then
  echo "id: '$name': no such user" >&2
  exit 1
fi
echo "$line" | cut -d' ' -f2
exit 0
